<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConectividadeHost</AssemblyName>
    <RootNamespace>ConectividadeHost</RootNamespace>
    <!-- Para publicar como .exe unico e autossuficiente (sem exigir .NET instalado
         no cliente), veja o comando de publish no README.md. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
